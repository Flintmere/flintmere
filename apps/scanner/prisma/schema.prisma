// Flintmere scanner database schema.
// Canonical per `projects/flintmere/ARCHITECTURE.md` §Database schema.
// Scanner-only tables; the Shopify app owns `app_*` tables in its own schema.

generator client {
  provider      = "prisma-client-js"
  // Per-app output so the scanner's generated client and the shopify-app's
  // can coexist in pnpm's hoisted node_modules. Without `output`, both apps
  // race over the same `.prisma/client/` location and only the most recently
  // generated schema is type-visible.
  output        = "../src/generated/prisma"
  // `linux-musl-openssl-3.0.x` is the runtime target (node:22-alpine uses musl).
  // `native` covers the build host. Both must be present or PrismaClient throws
  // at first query with `Failed to load query engine`.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScanStatus {
  pending
  running
  complete
  failed
}

enum ScanSource {
  user
  bot
  rescan_30_day
}

model Scan {
  id          String     @id @default(cuid())
  shopUrl     String     @map("shop_url")
  normalisedDomain String @map("normalised_domain")
  status      ScanStatus @default(pending)
  source      ScanSource @default(user)
  vertical    String?    @db.VarChar(64)
  score       Int?
  grade       String?
  scoreJson   Json?      @map("score_json")
  productCount Int?      @map("product_count")
  variantCount Int?      @map("variant_count")
  errorCode   String?    @map("error_code")
  errorMessage String?   @map("error_message")
  ipHash      String?    @map("ip_hash")
  userAgent   String?    @map("user_agent")
  publishedToBenchmark Boolean @default(false) @map("published_to_benchmark")
  publishedAt DateTime?  @map("published_at")
  publishPublicPage Boolean @default(false) @map("publish_public_page")
  publicPageAt DateTime? @map("public_page_at")
  // Per ADR 0023 slice 3 — separate consent gate for publishing GMC
  // ground-truth counts on the public score page. Existing
  // publishPublicPage consent covers pillar scores only; merchant's
  // GMC disapproval data is a different data class. Defaults false;
  // requires publishPublicPage=true as a precondition (server-enforced
  // in /api/scan/:id/publish-gmc-on-public-page).
  publishGmcOnPublicPage Boolean @default(false) @map("publish_gmc_on_public_page")
  publishGmcOnPublicPageAt DateTime? @map("publish_gmc_on_public_page_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  startedAt   DateTime?  @map("started_at")
  completedAt DateTime?  @map("completed_at")
  leads       Lead[]

  @@index([normalisedDomain])
  @@index([createdAt])
  @@index([status])
  @@index([source])
  @@index([vertical])
  @@index([publishedToBenchmark])
  @@index([publishPublicPage])
  @@map("scanner_scans")
}

model Lead {
  id             String    @id @default(cuid())
  email          String
  scanId         String    @map("scan_id")
  scan           Scan      @relation(fields: [scanId], references: [id])
  consentedAt    DateTime  @default(now()) @map("consented_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  reportSentAt   DateTime? @map("report_sent_at")
  reportOpenedAt DateTime? @map("report_opened_at")

  // Idempotency key for /api/lead — repeated POSTs with the same
  // email + scan return the existing row instead of sending a duplicate
  // report. Email is normalised to lowercase at the API boundary.
  @@unique([email, scanId])
  @@index([email])
  @@index([scanId])
  @@map("scanner_leads")
}

model ConciergeAudit {
  id             String    @id @default(cuid())
  email          String
  shopUrl        String    @map("shop_url")
  stripePaymentIntentId String @unique @map("stripe_payment_intent_id")
  status         String    @default("paid")
  calendlyUrl    String?   @map("calendly_url")
  notificationSentAt DateTime? @map("notification_sent_at")
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Day-30 re-scan tracking. Per the audit-delivery email, every paid
  // audit gets a free re-scan 30 days after delivery so the merchant can
  // see what shifted. Capture happens in `scripts/audit-deliver.ts` at
  // delivery time; execution happens in the rescan-30-day cron.
  // baselineScanId points at the scanner_scans row that was the merchant's
  // pre-audit state (latest scan for shopUrl at delivery time).
  // baselineScoreJson is a denormalised snapshot so the re-scan email
  // can compare without a join.
  baselineScanId      String?   @map("baseline_scan_id")
  baselineScoreJson   Json?     @map("baseline_score_json")
  rescanDueAt         DateTime? @map("rescan_due_at")
  rescanScanId        String?   @map("rescan_scan_id")
  rescanCompletedAt   DateTime? @map("rescan_completed_at")
  rescanEmailSentAt   DateTime? @map("rescan_email_sent_at")

  @@index([email])
  @@index([status])
  // Scoped index for the cron's "what's due" query — partial would be
  // better but Prisma's Postgres provider doesn't surface partial-index
  // syntax, so we index the column and filter at query time.
  @@index([rescanDueAt])
  @@map("scanner_concierge_audits")
}

enum ContactTopic {
  general
  privacy
  security
  billing
  legal
  plus
  concierge
  partnership
}

enum ContactStatus {
  new
  acknowledged
  responded
  archived
  spam
}

model ContactMessage {
  id             String        @id @default(cuid())
  topic          ContactTopic
  name           String
  email          String
  company        String?
  shopifyDomain  String?       @map("shopify_domain")
  message        String        @db.Text
  status         ContactStatus @default(new)
  routedTo       String        @map("routed_to")
  source         String?
  ipHash         String?       @map("ip_hash")
  userAgent      String?       @map("user_agent")
  acknowledgedAt DateTime?     @map("acknowledged_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([topic])
  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("scanner_contact_messages")
}

/// One-time secret handoff. Used primarily for concierge-audit token
/// transfer (merchant pastes their Shopify Admin API token, gets a
/// single-use URL, sends URL to operator via email reply). Burned on
/// first read; deleted-on-burn would also work but we keep the row so
/// re-clicks return a useful "already consumed" signal instead of 404.
/// Server-side AES-256-GCM at rest with key from env var
/// ONETIMESECRET_KEY (32 bytes hex). Default TTL 24 hours.
model OneTimeSecret {
  id         String    @id @default(cuid())
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes     @map("auth_tag")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  @@index([expiresAt])
  @@map("scanner_one_time_secrets")
}

/// Magic-link sign-in tokens for the operator console at /admin/login.
/// Replaces the scrypt-password flow (deleted 2026-05-09). The raw token
/// is only ever in the email body and the URL the operator clicks; the
/// DB stores sha256(rawToken). A DB dump cannot forge sessions.
///
/// Lifecycle: created on POST /api/admin/magic-link/request → consumed on
/// GET /api/admin/magic-link/verify. `consumed_at` flips on first verify;
/// second click 401s. `email` is persisted so the verify route can confirm
/// allowlist match without re-derivation; allowlist also enforced at
/// request-time (defence in depth — no link emitted to non-allowlisted).
/// Default TTL 10 minutes (per OWASP magic-link guidance).
model MagicLinkToken {
  id         String    @id @default(cuid())
  tokenHash  Bytes     @unique @map("token_hash")
  email      String
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("scanner_magic_link_tokens")
}

/// Pre-verification waiting list for GMC OAuth. Captured during the
/// Google T&S verification window (typical 4–6 weeks) by merchants
/// who clicked the connect link from their audit delivery email while
/// `FEATURE_GMC_OAUTH=false`. `notifiedAt` is set the day verification
/// clears and we email the merchant. Per ADR 0023 §slice 2b. No FK to
/// `ConciergeAudit` — `auditId` is a soft reference so the request
/// retains shape even if the audit is later archived.
model GmcAccessRequest {
  id               String    @id @default(cuid())
  auditId          String    @map("audit_id")
  email            String
  shopUrl          String    @map("shop_url")
  normalisedDomain String    @map("normalised_domain")
  reason           String?
  notifiedAt       DateTime? @map("notified_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([auditId])
  @@index([normalisedDomain])
  @@index([notifiedAt])
  @@map("scanner_gmc_access_requests")
}

/// Merchant's connected Google Merchant Center account. Per ADR 0023,
/// the audit's ground-truth track. One row per merchant; @@unique on
/// normalised_domain enforces single active connection. Reconnect after
/// revoke updates the row in place (revokedAt cleared, ciphertext
/// rewritten). Refresh token encrypted at rest with AES-256-GCM
/// (key from GMC_TOKEN_KEY, 32 bytes hex). Access tokens never
/// persisted — rotated on demand from refresh token, held in memory +
/// short-TTL cache only. Disconnect zeros the ciphertext + sets
/// revokedAt; row remains for audit trail.
model MerchantGmcConnection {
  id                    String    @id @default(cuid())
  normalisedDomain      String    @unique @map("normalised_domain")
  gmcAccountId          String?   @map("gmc_account_id")
  gmcAccountName        String?   @map("gmc_account_name")
  refreshTokenCipher    Bytes     @map("refresh_token_cipher")
  refreshTokenIv        Bytes     @map("refresh_token_iv")
  refreshTokenAuthTag   Bytes     @map("refresh_token_auth_tag")
  scopes                String[]
  connectedAt           DateTime  @default(now()) @map("connected_at")
  lastSyncedAt          DateTime? @map("last_synced_at")
  lastErrorCode         String?   @map("last_error_code")
  lastErrorAt           DateTime? @map("last_error_at")
  revokedAt             DateTime? @map("revoked_at")

  @@index([gmcAccountId])
  @@index([revokedAt])
  @@map("scanner_merchant_gmc_connections")
}

/// Stripe webhook event-ID idempotency. PK on event_id is the lock —
/// a unique-violation race resolves cleanly: loser returns 200 (replay),
/// winner proceeds to dispatch. Failed dispatches leave the row in
/// place and Sentry alert is the manual-recovery signal. Retention
/// ~30 days (Stripe's max retry window); processedAt index supports
/// the prune query. See ADR 0023 + apps/scanner/src/app/api/webhooks/
/// stripe/route.ts.
model StripeProcessedEvent {
  eventId     String   @id @map("event_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("scanner_stripe_processed_events")
}

/// Cold-email outreach pipeline (sprint 2026-05-09 → 2026-05-23).
/// Sends from `team.flintmere.com` (separate Resend domain to keep apex
/// `hello@flintmere.com` transactional reputation intact). One row per
/// merchant in the cohort. Status flow:
///   pending  → no recipient_email + first_name yet (CSV uploaded, awaits enrich)
///   enriched → email + first_name set, score present, ready to queue
///   queued   → scheduled for next send batch (cap-gated)
///   sent     → initial send fired, awaiting reply or +5d follow-up
///   followed_up → +5d follow-up fired, awaiting reply
///   replied  → operator marked replied (or Resend webhook caught reply)
///   unsubscribed → `outreach_unsubscribes` row exists or operator marked
///   bounced  → Resend webhook flagged hard bounce
///   dropped  → operator removed (no-target, wrong-fit, etc.)
///
/// `source` is informational ('cohort-2026-05-09' | 'round1-2026-05-05'
/// | 'manual'). `shop_domain` is the global uniqueness key — one outreach
/// row per merchant across all sources. CSV upload upserts on shop_domain.
///
/// `subject_variant` controls A/B between the two subject lines in the
/// template. Default 'A'; admin UI flips per-row before queue.
model OutreachTarget {
  id             String         @id @default(cuid())
  shopDomain     String         @unique @map("shop_domain")
  recipientEmail String?        @map("recipient_email")
  firstName      String?        @map("first_name")
  score          Int?
  grade          String?        @db.VarChar(2)
  productCount   Int?           @map("product_count")
  ukSignal       Boolean        @default(false) @map("uk_signal")
  scanId         String?        @map("scan_id")
  rescanUrl      String?        @map("rescan_url")
  source         String
  status         String         @default("pending")
  subjectVariant String         @default("A") @map("subject_variant") @db.VarChar(1)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  sentAt         DateTime?      @map("sent_at")
  followedUpAt   DateTime?      @map("followed_up_at")
  repliedAt      DateTime?      @map("replied_at")
  droppedReason  String?        @map("dropped_reason")
  // Auto-enrichment scaffolding (cron: /api/cron/outreach-enrich).
  // `enrichmentDraft` is a structured JSON blob produced by Gemini 2.5
  // Flash against the merchant's public About + Contact pages — see
  // lib/outreach/enrich.ts §EnrichmentDraft. Operator reviews + clicks
  // 'apply' in the admin UI, or auto-applies when both conditions hold:
  //   (a) OUTREACH_AUTO_APPLY_ENRICHMENT=true env var set
  //   (b) draft.email.confidence='high' AND domain matches shop_domain
  // `enrichmentAttemptedAt` is the cron's last-touched timestamp; the
  // 24h re-attempt window stops the cron from re-fetching every hour.
  enrichmentDraft       Json?     @map("enrichment_draft")
  enrichmentAttemptedAt DateTime? @map("enrichment_attempted_at")
  enrichmentFailedReason String?  @map("enrichment_failed_reason")
  // Marketing-automation batch approval (ADR 0026). Agent stages targets
  // with status='ready_for_approval' + batchId; /api/approve flips them
  // to 'queued' and stamps approvedAt. batchId NULL ⇒ legacy path,
  // untouched by approval flow.
  batchId    String?   @map("batch_id")
  approvedAt DateTime? @map("approved_at")
  sends          OutreachSend[]

  @@index([status])
  @@index([recipientEmail])
  @@index([sentAt])
  @@index([batchId])
  @@map("scanner_outreach_targets")
}

/// One row per send (initial OR followup). Idempotent on (target_id, kind)
/// — prevents accidental double-sends. `delivery_status` updated by the
/// Resend webhook (bounce / complaint events flip 'sent' → 'bounced' or
/// 'complained').
model OutreachSend {
  id              String         @id @default(cuid())
  targetId        String         @map("target_id")
  target          OutreachTarget @relation(fields: [targetId], references: [id])
  kind            String         // 'initial' | 'followup'
  subjectVariant  String         @map("subject_variant") @db.VarChar(1)
  subject         String
  bodyHtml        String         @map("body_html") @db.Text
  bodyText        String         @map("body_text") @db.Text
  resendMessageId String?        @map("resend_message_id")
  deliveryStatus  String         @default("sent") @map("delivery_status")
  sentAt          DateTime       @default(now()) @map("sent_at")
  errorMessage    String?        @map("error_message") @db.Text

  @@unique([targetId, kind])
  @@index([targetId])
  @@index([deliveryStatus])
  @@map("scanner_outreach_sends")
}

/// Permanent unsubscribes. Checked before EVERY send (initial AND
/// followup) by `lib/outreach/send.ts`. Sources:
///   list-unsubscribe-header → one-click POST to /api/outreach/unsubscribe
///   reply                   → operator-marked from admin UI
///   manual                  → operator added directly
/// Email is normalised to lowercase at the API boundary.
model OutreachUnsubscribe {
  id             String   @id @default(cuid())
  recipientEmail String   @unique @map("recipient_email")
  unsubscribedAt DateTime @default(now()) @map("unsubscribed_at")
  source         String

  @@map("scanner_outreach_unsubscribes")
}

/// Resend webhook event-ID idempotency. Mirrors StripeProcessedEvent.
/// PK race on event_id resolves duplicate webhook deliveries cleanly —
/// loser returns 200 (replay), winner proceeds to dispatch. Retention
/// ~30 days; processedAt index supports prune.
model ResendProcessedEvent {
  eventId     String   @id @map("event_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("scanner_resend_processed_events")
}

/// Audit-assist v0 draft. One row per concierge-audit draft generated by
/// Gemini 2.5 Pro on Vertex EU and edited by the operator before send.
/// `rawDraft` is the LLM output; `editedDraft` is the operator-corrected
/// version persisted on PATCH and used as the supervised-correction
/// corpus for prompt tuning + the eventual ingestion-engine UX (Gate 1).
/// `scanId` is a soft reference to scanner_scans (no FK) — keeps the
/// row shape stable if a scan is later archived. `bandSlug` matches
/// the canonical AuditBandSlug from `lib/audit-pricing.ts`
/// (`band-1 | band-2 | band-3`). Status lifecycle: `draft → edited → sent`
/// (string column, not enum, to keep v0 schema-evolution cheap).
/// See `context/plans/2026-05-06-audit-assist.md`.
model AuditDraft {
  id          String    @id @default(cuid())
  shop        String
  vertical    String
  bandSlug    String    @map("band_slug")
  scanId      String?   @map("scan_id")
  status      String    @default("draft")
  modelUsed   String    @map("model_used")
  latencyMs   Int       @map("latency_ms")
  rawDraft    Json      @map("raw_draft")
  editedDraft Json?     @map("edited_draft")
  generatedAt DateTime  @map("generated_at")
  editedAt    DateTime? @map("edited_at")
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([shop])
  @@index([status])
  @@map("scanner_audit_drafts")
}

/// Agent-drafted social posts queued for deterministic publishing by
/// /api/cron/social-post. Per ADR 0026 — marketing automation pipeline.
/// status: queued → posted | failed. Failed rows are never auto-retried;
/// the daily brief flags them and the weekly agent re-queues or rewrites.
model SocialPost {
  id           String    @id @default(cuid())
  channel      String    // 'x' only for now
  body         String    @db.Text
  altText      String?   @map("alt_text") @db.Text
  utmCampaign  String    @map("utm_campaign")
  status       String    @default("queued")
  scheduledAt  DateTime  @map("scheduled_at")
  postedAt     DateTime? @map("posted_at")
  externalId   String?   @map("external_id")
  errorMessage String?   @map("error_message") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([status, scheduledAt])
  @@map("scanner_social_posts")
}
