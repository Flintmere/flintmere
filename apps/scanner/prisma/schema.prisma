// Flintmere scanner database schema.
// Canonical per `projects/flintmere/ARCHITECTURE.md` §Database schema.
// Scanner-only tables; the Shopify app owns `app_*` tables in its own schema.

generator client {
  provider      = "prisma-client-js"
  // Per-app output so the scanner's generated client and the shopify-app's
  // can coexist in pnpm's hoisted node_modules. Without `output`, both apps
  // race over the same `.prisma/client/` location and only the most recently
  // generated schema is type-visible.
  output        = "../src/generated/prisma"
  // `linux-musl-openssl-3.0.x` is the runtime target (node:22-alpine uses musl).
  // `native` covers the build host. Both must be present or PrismaClient throws
  // at first query with `Failed to load query engine`.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScanStatus {
  pending
  running
  complete
  failed
}

enum ScanSource {
  user
  bot
  rescan_30_day
}

model Scan {
  id          String     @id @default(cuid())
  shopUrl     String     @map("shop_url")
  normalisedDomain String @map("normalised_domain")
  status      ScanStatus @default(pending)
  source      ScanSource @default(user)
  vertical    String?    @db.VarChar(64)
  score       Int?
  grade       String?
  scoreJson   Json?      @map("score_json")
  productCount Int?      @map("product_count")
  variantCount Int?      @map("variant_count")
  errorCode   String?    @map("error_code")
  errorMessage String?   @map("error_message")
  ipHash      String?    @map("ip_hash")
  userAgent   String?    @map("user_agent")
  publishedToBenchmark Boolean @default(false) @map("published_to_benchmark")
  publishedAt DateTime?  @map("published_at")
  publishPublicPage Boolean @default(false) @map("publish_public_page")
  publicPageAt DateTime? @map("public_page_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  startedAt   DateTime?  @map("started_at")
  completedAt DateTime?  @map("completed_at")
  leads       Lead[]

  @@index([normalisedDomain])
  @@index([createdAt])
  @@index([status])
  @@index([source])
  @@index([vertical])
  @@index([publishedToBenchmark])
  @@index([publishPublicPage])
  @@map("scanner_scans")
}

model Lead {
  id             String    @id @default(cuid())
  email          String
  scanId         String    @map("scan_id")
  scan           Scan      @relation(fields: [scanId], references: [id])
  consentedAt    DateTime  @default(now()) @map("consented_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  reportSentAt   DateTime? @map("report_sent_at")
  reportOpenedAt DateTime? @map("report_opened_at")

  // Idempotency key for /api/lead — repeated POSTs with the same
  // email + scan return the existing row instead of sending a duplicate
  // report. Email is normalised to lowercase at the API boundary.
  @@unique([email, scanId])
  @@index([email])
  @@index([scanId])
  @@map("scanner_leads")
}

model ConciergeAudit {
  id             String    @id @default(cuid())
  email          String
  shopUrl        String    @map("shop_url")
  stripePaymentIntentId String @unique @map("stripe_payment_intent_id")
  status         String    @default("paid")
  calendlyUrl    String?   @map("calendly_url")
  notificationSentAt DateTime? @map("notification_sent_at")
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Day-30 re-scan tracking. Per the audit-delivery email, every paid
  // audit gets a free re-scan 30 days after delivery so the merchant can
  // see what shifted. Capture happens in `scripts/audit-deliver.ts` at
  // delivery time; execution happens in the rescan-30-day cron.
  // baselineScanId points at the scanner_scans row that was the merchant's
  // pre-audit state (latest scan for shopUrl at delivery time).
  // baselineScoreJson is a denormalised snapshot so the re-scan email
  // can compare without a join.
  baselineScanId      String?   @map("baseline_scan_id")
  baselineScoreJson   Json?     @map("baseline_score_json")
  rescanDueAt         DateTime? @map("rescan_due_at")
  rescanScanId        String?   @map("rescan_scan_id")
  rescanCompletedAt   DateTime? @map("rescan_completed_at")
  rescanEmailSentAt   DateTime? @map("rescan_email_sent_at")

  @@index([email])
  @@index([status])
  // Scoped index for the cron's "what's due" query — partial would be
  // better but Prisma's Postgres provider doesn't surface partial-index
  // syntax, so we index the column and filter at query time.
  @@index([rescanDueAt])
  @@map("scanner_concierge_audits")
}

enum ContactTopic {
  general
  privacy
  security
  billing
  legal
  plus
  concierge
  partnership
}

enum ContactStatus {
  new
  acknowledged
  responded
  archived
  spam
}

model ContactMessage {
  id             String        @id @default(cuid())
  topic          ContactTopic
  name           String
  email          String
  company        String?
  shopifyDomain  String?       @map("shopify_domain")
  message        String        @db.Text
  status         ContactStatus @default(new)
  routedTo       String        @map("routed_to")
  source         String?
  ipHash         String?       @map("ip_hash")
  userAgent      String?       @map("user_agent")
  acknowledgedAt DateTime?     @map("acknowledged_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([topic])
  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("scanner_contact_messages")
}

/// One-time secret handoff. Used primarily for concierge-audit token
/// transfer (merchant pastes their Shopify Admin API token, gets a
/// single-use URL, sends URL to operator via email reply). Burned on
/// first read; deleted-on-burn would also work but we keep the row so
/// re-clicks return a useful "already consumed" signal instead of 404.
/// Server-side AES-256-GCM at rest with key from env var
/// ONETIMESECRET_KEY (32 bytes hex). Default TTL 24 hours.
model OneTimeSecret {
  id         String    @id @default(cuid())
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes     @map("auth_tag")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  @@index([expiresAt])
  @@map("scanner_one_time_secrets")
}
