# Flintmere scanner — environment template
# Copy to .env.local for development. Production values live in Coolify.

# ---- Required ----

# Postgres connection (Coolify-provisioned in prod; docker-compose local in dev)
DATABASE_URL="postgresql://flintmere:flintmere_dev@localhost:5432/flintmere_dev?schema=scanner"

# Public base URL (no trailing slash). Scheme determines whether
# admin session + OTP cookies emit the Secure flag — see
# apps/scanner/src/lib/admin-auth.ts buildCookieAttributes. Set this to
# the actual https://… URL on every Coolify deploy (production AND
# staging/preview); HTTP value is for local dev only.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Marketing-host base URL (used in transactional email + cross-host
# links). flintmere.com in production; can point at a preview host in
# staging.
# NEXT_PUBLIC_MARKETING_URL="https://flintmere.com"

# Scanner-host origin (used by the audit-handoff helper for cross-host
# sessionStorage handoff and audit-link composition).
# NEXT_PUBLIC_SCANNER_ORIGIN="https://audit.flintmere.com"

# Concierge-audit ops inbox — receives a copy of every audit-purchase
# notification fired from the Stripe webhook. Used by the SLA monitor
# to track turnaround. Operator's address.
# CONCIERGE_OPS_EMAIL="hello@flintmere.com"

# ---- LLM (used by the app, not scanner MVP; set for future compatibility) ----

# LLM_PRIMARY_PROVIDER="vertex"
# LLM_PRIMARY_MODEL="gemini-2.5-flash"
# LLM_PRIMARY_REGION="europe-west1"
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# ---- Email (scanner full-report delivery) ----

# Resend API key (resend.com). Create a sending domain; point DNS (SPF/DKIM/DMARC).
RESEND_API_KEY=""
RESEND_FROM_ADDRESS="Flintmere <hello@flintmere.com>"
RESEND_REPLY_TO="hello@flintmere.com"

# ---- Daily operator brief (cron) ----
# Recipient + sender for the daily-brief cron. Defaults shipped in code
# so both are optional. Internal channel: hello@flintmere.com → operator
# inbox info@eazyaccess.org. Apex `hello@` (not `cron@team.…`) because
# this is internal traffic, not cold outreach — apex deliverability is
# fine and the inbox label reads as a normal team email, not automation.
# DAILY_BRIEF_RECIPIENT="info@eazyaccess.org"
# DAILY_BRIEF_FROM="Flintmere <hello@flintmere.com>"
# DAILY_BRIEF_MODEL="gemini-2.5-flash"

# HMAC secret for signed unsubscribe tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
UNSUBSCRIBE_SECRET=""

# Salt for hashing IPs (one-way; kept as rate-limit key without storing raw IP)
IP_HASH_SALT="flintmere-default-salt-change-me"

# ---- Stripe (concierge audit band ladder — £197 / £397 / from £597) ----
# Use sk_test_… / pk_test_… / test-mode whsec_… / test-mode price_… in
# preview + local; sk_live_… / pk_live_… etc. in production. Never
# commit real values — even test keys are scoped credentials, and the
# account-ID segment after the prefix is shared with live keys.
# Placeholders only in this file; real values go in Coolify env or
# .env.local (both gitignored).

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_CONCIERGE_PRICE_ID=""

# Calendly link for concierge kickoff call
CALENDLY_CONCIERGE_URL="https://calendly.com/flintmere/concierge-audit"

# ---- Observability (optional in dev) ----

# Sentry error tracking (EU region — sentry.io de-region account).
# Same DSN used both server- and client-side. The DSN is a public project
# write-key by Sentry's design; not a secret. Mark Available at Buildtime
# AND Available at Runtime in Coolify.
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<id>.ingest.de.sentry.io/<project>"
#
# For source-map upload (better stack traces at build time) AND the
# /admin/health daily-check page (runtime read of the Issues API).
# Generate in Sentry → Settings → Auth Tokens with scopes:
# `project:read` + `event:read`. Mark Available at Buildtime AND
# Available at Runtime in Coolify.
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG="flintmere"
# SENTRY_PROJECT="flintmere-scanner"

# ---- BetterStack Uptime (operator daily health page) ----
# API token from betterstack.com/team-id/api-tokens. Used by
# /admin/health to surface monitor status (any monitor red in 24h).
# Mark Runtime-only. Read-only token scope is enough.
# BETTERSTACK_API_KEY=""

# ---- PostHog Query API (operator daily health page) ----
# Personal API key (scopes: query:read, insight:write, dashboard:write —
# the write scopes are for scripts/provision-posthog.ts) from
# eu.posthog.com → settings → personal API keys. Numeric project ID from
# the project's URL/settings. Used by /admin/health for yesterday's
# pageviews and by the dashboard provisioning script. Mark Runtime-only.
# The public phc_ project key is hardcoded in
# apps/scanner/src/lib/analytics-config.ts (public-by-design, ADR 0025).
# POSTHOG_PERSONAL_API_KEY=""
# POSTHOG_PROJECT_ID=""
#
# Sentry self-test gate. Set to "true" temporarily, redeploy, GET
# /api/_sentry-test to fire a verification error, then unset.
# SENTRY_TEST_ENABLED="false"

# ---- Coolify scheduled-task auth ----
# Shared secret for the Coolify scheduled-task → /api/cron/* HTTP route
# pattern. Must be ≥32 chars, random. Mark Runtime-only in Coolify.
# Generate with: openssl rand -hex 32
# Used by:
#   - /api/cron/concierge-sla (concierge SLA monitor, daily 09:00 UTC Mon-Fri)
#   - /api/cron/daily-brief (operator daily brief, 06:00 UTC daily = 07:00 BST)
# CRON_SECRET="paste-the-openssl-output-here"

# ---- Cloudflare Turnstile (CAPTCHA on public forms) ----
# Site key is public (rendered in the client widget); mark Available at
# Buildtime AND Runtime in Coolify. Secret key is server-only; mark
# Runtime only.
# Used by /contact (and any future public form). When both are unset
# in non-production, the helper bypasses verification so local dev
# round-trips without keys.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAA…"
# TURNSTILE_SECRET_KEY="0x4AAA…"

# ---- Rate limiting ----

# Redis (Coolify-provisioned in prod)
# REDIS_URL="redis://localhost:6379"

# ---- One-time-secret service ----
#
# /secret + /secret/[id] use client-side AES-256-GCM via the Web
# Crypto API. The decryption key is generated in the browser and lives
# in the URL fragment (after `#`), which by RFC 3986 §3.5 never reaches
# the server. The server stores ciphertext only and has no way to
# decrypt — there is no server-side key. No env var to set.

# ---- Admin auth (audit-assist v0) ----
#
# Single-admin gate behind /admin/* and /api/admin/*. Sign-in front door
# is the magic-link flow at /api/admin/magic-link/{request,verify}; the
# scrypt-password flow was retired 2026-05-09.
#
# Mark both vars Runtime-only in Coolify; never commit real values.
#
# ADMIN_EMAIL — the single allowlisted operator address. Email-OTP
# requests for any other address silently no-op (no email sent); the
# session cookie carries this email and mismatches are rejected.
# ADMIN_EMAIL="info@eazyaccess.org"
#
# ADMIN_SESSION_SECRET — HMAC-SHA256 secret. Used for both the session
# cookie AND the X-Admin-Smoke-Token header (laptop-side smoke scripts).
# Must be ≥32 random bytes. Rotating invalidates every existing session
# AND every laptop smoke-token; re-derive scripts after rotating.
#   openssl rand -hex 32
# ADMIN_SESSION_SECRET=""

# ---- Audit-assist v0 feature flag ----
#
# Gates the LLM-powered draft-audit generator behind /admin/audit-draft.
# Default off; set to "true" once Vertex SA key + admin auth are wired.
# FEATURE_AUDIT_ASSIST="false"
