{
  "name": "scanner",
  "version": "0.0.1",
  "private": true,
  "description": "Flintmere public scanner at audit.flintmere.com — 60-second AI-readiness audit for any public Shopify store.",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "benchmark:compile": "tsx scripts/compile-store-list.ts",
    "benchmark:qualifying": "tsx scripts/benchmark-qualifying-count.ts",
    "benchmark:scan": "tsx scripts/batch-scan.ts",
    "benchmark:scan:food": "FILTER_VERTICAL=food-and-drink CONCURRENCY=1 PACE_MS=2500 tsx scripts/batch-scan.ts",
    "cohort:design-partners": "tsx scripts/export-design-partner-cohort.ts",
    "cohort:diagnose": "tsx scripts/cohort-funnel-diagnose.ts",
    "purge:contact-threads": "tsx scripts/purge-contact-threads.ts",
    "audit:csv": "tsx scripts/export-audit-csv.ts",
    "audit:deliver": "tsx scripts/audit-deliver.ts",
    "audit:sla-monitor": "tsx scripts/concierge-sla-monitor.ts"
  },
  "dependencies": {
    "@flintmere/llm": "workspace:*",
    "@flintmere/scoring": "workspace:*",
    "@flintmere/ui": "workspace:*",
    "@googleapis/content": "^42.2.1",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.50.0",
    "@stripe/react-stripe-js": "^3.1.1",
    "@stripe/stripe-js": "^5.5.0",
    "geist": "^1.3.1",
    "google-auth-library": "^10.6.2",
    "motion": "^12.38.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.0",
    "stripe": "^17.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
